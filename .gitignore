
# Ignore sensitive files
service_account.json
google_sheets_oath.json

# Ignore Python cache files
__pycache__/
*.py[cod]

# Ignore virtual environment folders
venv/
myenv2/

# Ignore environment variables files
.env

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore macOS system files
.DS_Store

service_account.json
google_sheets_oauth.json

# Shorts video pipeline: rendered outputs and caches
shorts/projects/*/output/
shorts/projects/*/.cache/
shorts/projects/_test/
# Stock video clips are large (often 100MB+ in 4K); re-download with `search/pick` instead
shorts/projects/*/media/*.mp4
shorts/projects/*/media/*.mov
shorts/projects/*/media/*.webm
# Voice recordings (personal; re-downloadable from the Shorts Queue page)
shorts/projects/*/media/voiceover*
shorts/.env
